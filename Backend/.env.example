GOOGLE_CLOUD_PROJECT=bitsomvertexproj
GOOGLE_CLOUD_LOCATION=us-central1
BQ_DATASET=p2p

# From deploy.py output
AGENT_ENGINE_RESOURCE=

# Document AI. Leave DOCAI_PROCESSOR_ID empty to run fixture mode only.
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# Pre-extracted invoice JSONs. Relative paths resolve against Src/Backend.
FIXTURES_DIR=fixtures

INVOICES_BUCKET=bitsomvertexproj-invoices
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cost model for the metrics panel
MANUAL_COST_PER_INVOICE=13.50
MANUAL_MINUTES_PER_INVOICE=9
